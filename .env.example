APP_NAME="Station Example"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - MySQL via Station Docker services
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=station_example
DB_USERNAME=station
DB_PASSWORD=station

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=database

# Redis - via Station Docker services
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# RabbitMQ - via Station Docker services
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=station
RABBITMQ_PASSWORD=station
RABBITMQ_VHOST=station

# SQS - LocalStack via Station Docker services
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
SQS_ENDPOINT=http://localstack:4566
SQS_PREFIX=http://localstack:4566/000000000000
SQS_QUEUE=default

# Beanstalkd - via Station Docker services
BEANSTALKD_HOST=beanstalkd
BEANSTALKD_PORT=11300

# Kafka - via Station Docker services (internal port for container-to-container)
KAFKA_BROKERS=kafka:29092

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Station Configuration
STATION_PROCESS_MANAGEMENT=true
# WARNING: STATION_API_AUTH=none disables API token authentication.
# For production, use 'token' and set STATION_API_TOKEN.
STATION_API_AUTH=none

# RabbitMQ Management API (for driver stats in dashboard)
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
RABBITMQ_MANAGEMENT_USER=station
RABBITMQ_MANAGEMENT_PASSWORD=station
