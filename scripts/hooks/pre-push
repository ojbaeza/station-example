#!/bin/sh
#
# Pre-push hook: Run tests (same as CI)

set -e

echo "🚀 Running pre-push checks..."
echo ""

# Check if Docker container is running
if ! docker ps --format '{{.Names}}' | grep -q '^station_example$'; then
    echo "❌ Error: station_example container is not running"
    echo "   Run: docker compose up -d"
    exit 1
fi

# 1. Security Audit
echo "🔒 [1/2] Running security audit..."
if ! docker exec station_example sh -c "composer audit --no-interaction"; then
    echo ""
    echo "❌ Security vulnerabilities found. Please review and fix them."
    exit 1
fi
echo "✅ Security audit passed"
echo ""

# 2. PHPUnit Tests
echo "🧪 [2/2] Running tests..."
if ! docker exec station_example sh -c "XDEBUG_MODE=off php artisan test --no-progress"; then
    echo ""
    echo "❌ Tests failed. Please fix them before pushing."
    exit 1
fi
echo "✅ Tests passed"
echo ""

echo "✅ All pre-push checks passed! Safe to push."
